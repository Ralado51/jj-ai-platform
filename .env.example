# Application
APP_NAME=JJ AI Platform API
APP_VERSION=0.1.0
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=jjplatform
POSTGRES_USER=jjplatform
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# API
API_PORT=8000

# SQLAlchemy
DATABASE_URL=postgresql+psycopg://jjplatform:change_this_password@postgres:5432/jjplatform

# MinIO / S3-compatible storage
MINIO_ROOT_USER=jjplatform_admin
MINIO_ROOT_PASSWORD=change_this_to_a_long_random_password
MINIO_CONSOLE_DOMAIN=storage.jjnetwork.com.br
MINIO_API_DOMAIN=files.jjnetwork.com.br
MINIO_BROWSER_REDIRECT_URL=https://storage.jjnetwork.com.br
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://files.jjnetwork.com.br
S3_BUCKET=jj-ai-projects
S3_REGION=us-east-1
S3_USE_SSL=false

# Image generation
HF_TOKEN=
HF_IMAGE_PROVIDER=auto
HF_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
IMAGE_GENERATION_TIMEOUT_SECONDS=180
IMAGE_GENERATION_BATCH_CONCURRENCY=2

# Pull-based image workers
# Use a long random secret and send it in the X-JJ-Worker-Token header.
IMAGE_WORKER_TOKEN=change_this_to_a_long_random_worker_token
